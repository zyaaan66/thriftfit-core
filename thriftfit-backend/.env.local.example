# Public — safe to expose to the browser (used for client-side reads with RLS enforced)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret — server-only, NEVER expose to the browser or commit to git.
# Used by API route handlers to bypass RLS for admin-style operations
# (holding items, finalizing checkout, etc).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Midtrans (payment gateway) — from your Midtrans dashboard.
# Get sandbox keys at https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_IS_PRODUCTION=false

# Public — the frontend needs this to load Midtrans Snap.js.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your-midtrans-client-key
